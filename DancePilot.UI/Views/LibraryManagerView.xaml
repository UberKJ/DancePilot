<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DancePilot.UI.Views.LibraryManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#05080B" />
        <SolidColorBrush x:Key="TopChromeBrush" Color="#0B1117" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1015" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#111922" />
        <SolidColorBrush x:Key="LineBrush" Color="#27313B" />
        <SolidColorBrush x:Key="MutedLineBrush" Color="#19222C" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F8FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B5C0C9" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7E8A95" />
        <SolidColorBrush x:Key="YellowBrush" Color="#F4B400" />
        <SolidColorBrush x:Key="BlueBrush" Color="#1EA7FF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#32E76A" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#B875FF" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#101821" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#26313C" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#070B10" />
        <SolidColorBrush x:Key="ListDividerBrush" Color="#17212A" />

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="35" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="25" />
        </Style>

        <Style x:Key="SmallMutedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="ListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid
        Padding="12"
        Background="{StaticResource AppBackgroundBrush}"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource TopChromeBrush}" BorderBrush="{StaticResource MutedLineBrush}" BorderThickness="1" CornerRadius="6">
            <Grid Padding="16,0" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image
                    Grid.ColumnSpan="3"
                    Source="ms-appx:///Assets/Branding/DancePilotHeader.png"
                    Stretch="UniformToFill"
                    Opacity="0.16"
                    IsHitTestVisible="False" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Border Width="34" Height="34" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                        <Image Source="ms-appx:///Assets/Branding/dancepilot_icon_64.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Spacing="0">
                        <TextBlock Text="DancePilot" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Planning workspace" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Library Manager" Foreground="{StaticResource GreenBrush}" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Version 0.5.0 - Library Manager Shell" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button
                        Click="LiveEventWorkspaceButton_Click"
                        Style="{StaticResource ChromeButtonStyle}"
                        Background="{Binding LiveEventWorkspaceButtonBackground}"
                        BorderBrush="{Binding LiveEventWorkspaceButtonBorderBrush}"
                        Foreground="{Binding LiveEventWorkspaceButtonForeground}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="15" />
                            <TextBlock Text="LIVE EVENT" />
                        </StackPanel>
                    </Button>
                    <Button
                        Click="LibraryManagerWorkspaceButton_Click"
                        Style="{StaticResource ChromeButtonStyle}"
                        Background="{Binding LibraryManagerWorkspaceButtonBackground}"
                        BorderBrush="{Binding LibraryManagerWorkspaceButtonBorderBrush}"
                        Foreground="{Binding LibraryManagerWorkspaceButtonForeground}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="15" />
                            <TextBlock Text="LIBRARY MANAGER" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="LIBRARY MANAGER" Foreground="{StaticResource GreenBrush}" Style="{StaticResource PanelTitleStyle}" />
                        <TextBlock Text="Version 0.5.0 - Library Manager Shell" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{Binding LibraryManagerSections}"
                        SelectedItem="{Binding SelectedLibraryManagerSection, Mode=TwoWay}"
                        SelectionMode="Single"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource ListItemStyle}" />
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid Visibility="{Binding MusicLibrarySectionVisibility}" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="70" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GreenBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid RowSpacing="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="LIBRARY SOURCES" Foreground="{StaticResource GreenBrush}" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Local music index" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="8">
                                    <TextBlock Text="Current Sources" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Local Folder" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LibraryManagerCurrentSourcePath}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{Binding LibraryManagerCurrentSourceStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BrowseLocalMusicFolder_Click" Style="{StaticResource ChromeButtonStyle}" MinHeight="36">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                            <TextBlock Text="ADD FOLDER" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Command="{Binding LoadLocalMusicCommand}" Style="{StaticResource ChromeButtonStyle}" MinHeight="36">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                            <TextBlock Text="RESCAN" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="3" Spacing="8">
                                    <TextBlock Text="Library Statistics" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding LibraryManagerSongCountDisplay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding LibraryManagerArtistCountDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding LibraryManagerAlbumCountDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                                            <TextBlock Text="{Binding LibraryManagerLastScanDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <TextBlock Text="MUSIC LIBRARY" Foreground="{StaticResource BlueBrush}" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Version 0.5.1" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="LibraryMusicSearchBox"
                                        Text="{Binding LocalMusicSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Search songs, artists, albums, or genres"
                                        Style="{StaticResource InputTextBoxStyle}"
                                        KeyUp="LibraryMusicSearchBox_KeyUp" />
                                    <Button Grid.Column="1" Command="{Binding SearchLocalMusicCommand}" Content="SEARCH" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                </Grid>

                                <Grid Grid.Row="2" RowSpacing="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Padding="8,0" ColumnSpacing="10" BorderBrush="{StaticResource ListDividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.25*" />
                                            <ColumnDefinition Width="1.25*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Album Art" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Title" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Artist" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="Album" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="Genre" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="Year" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="Duration" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="Source" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>

                                    <ListView
                                        Grid.Row="1"
                                        ItemsSource="{Binding LocalMusicTracks}"
                                        SelectedItem="{Binding SelectedLocalMusicTrack, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemContainerStyle="{StaticResource ListItemStyle}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,5" ColumnSpacing="10" BorderBrush="{StaticResource ListDividerBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1.25*" />
                                                        <ColumnDefinition Width="1.25*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="1">
                                                        <Image Source="{Binding AlbumArtUrl}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayArtist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Album}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Genre}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Year}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="6" Text="{Binding DurationDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="7" Text="Local" Foreground="{StaticResource GreenBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource YellowBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="210" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="SELECTED SONG" Foreground="{StaticResource YellowBrush}" Style="{StaticResource SectionTitleStyle}" />

                                <Border Grid.Row="1" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                                    <Image Source="{Binding SelectedLibrarySongAlbumArt}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Row="2" Spacing="3">
                                    <TextBlock Text="{Binding SelectedLibrarySongTitle}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" TextWrapping="WrapWholeWords" MaxLines="2" />
                                    <TextBlock Text="{Binding SelectedLibrarySongArtist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="WrapWholeWords" MaxLines="2" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="3">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Metadata" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedLibrarySongAlbum}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{Binding SelectedLibrarySongGenre}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{Binding SelectedLibrarySongYear}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedLibrarySongDuration}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedLibrarySongFileLocation}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                                        <TextBlock Text="{Binding SelectedLibrarySongProvider}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedLibrarySongFavorite}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedLibrarySongRating}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedLibrarySongCollections}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Songs" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding LibraryManagerSongCountDisplay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Artists" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding LibraryManagerArtistCountDisplay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Albums" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding LibraryManagerAlbumCountDisplay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock Text="Last Scan" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding LibraryManagerLastScanDisplay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PurpleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="28"
                    Visibility="{Binding LibraryManagerPlaceholderVisibility}">
                    <Grid>
                        <StackPanel Width="560" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LibraryManagerPlaceholderTitle}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="28" FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="{Binding LibraryManagerPlaceholderDescription}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="16" TextWrapping="WrapWholeWords" TextAlignment="Center" />
                            <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding LibraryManagerPlaceholderVersionDisplay}" Foreground="{StaticResource YellowBrush}" FontSize="14" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding LibraryManagerPlaceholderFeatureHeader}" Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding LibraryManagerPlaceholderItems}" HorizontalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                            <TextBlock Text="-" Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
