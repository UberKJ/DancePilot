                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Bind ViewModel.SpotifySearchRowHeight, Mode=OneWay}" />
                        <RowDefinition Height="{x:Bind ViewModel.SpotifyResultsRowHeight, Mode=OneWay}" />
                        <RowDefinition Height="{x:Bind ViewModel.LocalSearchRowHeight, Mode=OneWay}" />
                        <RowDefinition Height="{x:Bind ViewModel.LocalResultsRowHeight, Mode=OneWay}" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SpotifySearchBox"
                            Text="{x:Bind ViewModel.SpotifySearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search Spotify by song, artist, or album"
                            Style="{StaticResource InputTextBoxStyle}"
                            MinHeight="40"
                            FontSize="15"
                            KeyUp="SpotifySearchBox_KeyUp" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.SearchSpotifyTracksCommand}" Content="SEARCH" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.PlaySelectedSpotifySearchTrackCommand}" Content="CUE" Style="{StaticResource ChromeButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="10" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ActivePanelBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="10,0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PLAYLIST TRACKS" Foreground="{StaticResource BlueBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{x:Bind ViewModel.AddLoadedPlaylistToActiveDeckCommand}" Content="APPEND" Style="{StaticResource ChromeButtonStyle}" MinHeight="28" />
                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.ReplaceLoadedPlaylistOnActiveDeckCommand}" Content="REPLACE" Style="{StaticResource ChromeButtonStyle}" MinHeight="28" />
                                </Grid>
                                <ListView
                                    x:Name="SpotifyPreviewTracksList"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.SpotifyPreviewTracks, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSpotifyTrack, Mode=TwoWay}"
                                    SelectionMode="Extended"
                                    CanDragItems="True"
                                    DragItemsStarting="SourceList_DragItemsStarting"
                                    DragItemsCompleted="List_DragItemsCompleted"
                                    DoubleTapped="SpotifyPreviewTracksList_DoubleTapped"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ListItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="spotify:SpotifyTrackMetadata">
                                            <Grid Padding="10,6" ColumnSpacing="10" BorderBrush="{StaticResource ListDividerBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind DurationDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource ActivePanelBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="SEARCH RESULTS" Foreground="{StaticResource BlueBrush}" FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                                <ListView
                                    x:Name="SpotifySearchResultsList"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.SpotifySearchResults, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSpotifySearchTrack, Mode=TwoWay}"
                                    SelectionMode="Extended"
                                    CanDragItems="True"
                                    DragItemsStarting="SourceList_DragItemsStarting"
                                    DragItemsCompleted="List_DragItemsCompleted"
                                    DoubleTapped="SpotifySearchResultsList_DoubleTapped"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ListItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="spotify:SpotifyTrackMetadata">
                                            <Grid Padding="10,6" ColumnSpacing="10" BorderBrush="{StaticResource ListDividerBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind PopularityDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="8" Visibility="{x:Bind ViewModel.LocalSourceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="LocalMusicSearchBox"
                            Text="{x:Bind ViewModel.LocalMusicSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Filter local song mixes"
                            Style="{StaticResource InputTextBoxStyle}"
                            MinHeight="40"
                            FontSize="15"
                            KeyUp="LocalMusicSearchBox_KeyUp" />
                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{x:Bind ViewModel.LocalMusicSortOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedLocalMusicSortOption, Mode=TwoWay}"
                            Style="{StaticResource InputComboBoxStyle}"
                            MinHeight="40" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.LoadLocalMusicCommand}" Content="{x:Bind ViewModel.LocalLibraryScanButtonText, Mode=OneWay}" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Grid.Column="3" Command="{x:Bind ViewModel.SearchLocalMusicCommand}" Content="FILTER" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Grid.Column="4" Command="{x:Bind ViewModel.PlaySelectedLocalMusicCommand}" Content="CUE" Style="{StaticResource ChromeButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GreenBrush}" BorderThickness="1" CornerRadius="6" Visibility="{x:Bind ViewModel.LocalSourceVisibility, Mode=OneWay}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="LOCAL MUSIC FILES" Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                            <ListView
                                x:Name="LocalMusicList"
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.LocalMusicTracks, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedLocalMusicTrack, Mode=TwoWay}"
                                SelectionMode="Extended"
                                CanDragItems="True"
                                DragItemsStarting="SourceList_DragItemsStarting"
                                DragItemsCompleted="List_DragItemsCompleted"
                                DoubleTapped="LocalMusicList_DoubleTapped"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource ListItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:LocalMusicTrack">
                                        <Grid Padding="10,6" ColumnSpacing="10" BorderBrush="{StaticResource ListDividerBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Folder}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayArtist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Extension}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.LocalLibraryStatus, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource SelectedPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    AllowDrop="True"
                    DragOver="QueueList_DragOver"
                    Drop="SongQueueList_Drop">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="SONG QUEUE" Foreground="{StaticResource PrimaryTextBrush}" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel HorizontalAlignment="Right" Spacing="1">
                                <TextBlock Text="{x:Bind ViewModel.QueueViewDeckHeader, Mode=OneWay}" Foreground="{x:Bind ViewModel.QueueViewDeckBrush, Mode=OneWay}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind ViewModel.QueueViewDeckCountDisplay, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Click="AddSelectedSourceToDeckA_Click" Content="ADD A" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                            <Button Grid.Column="1" Click="AddSelectedSourceToDeckB_Click" Content="ADD B" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.ShowDeckAQueueCommand}"
                                Content="VIEW A"
                                Style="{StaticResource ChromeButtonStyle}"
                                Background="{x:Bind ViewModel.QueueViewDeckAButtonBackground, Mode=OneWay}"
                                BorderBrush="{x:Bind ViewModel.QueueViewDeckAButtonBorderBrush, Mode=OneWay}"
                                Foreground="{x:Bind ViewModel.QueueViewDeckAButtonForeground, Mode=OneWay}"
                                MinHeight="34" />
                            <Button
                                Grid.Column="3"
                                Command="{x:Bind ViewModel.ShowDeckBQueueCommand}"
                                Content="VIEW B"
                                Style="{StaticResource ChromeButtonStyle}"
                                Background="{x:Bind ViewModel.QueueViewDeckBButtonBackground, Mode=OneWay}"
                                BorderBrush="{x:Bind ViewModel.QueueViewDeckBButtonBorderBrush, Mode=OneWay}"
                                Foreground="{x:Bind ViewModel.QueueViewDeckBButtonForeground, Mode=OneWay}"
                                MinHeight="34" />
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.45*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{x:Bind ViewModel.MoveSelectedQueueItemUpCommand}" Content="UP" Style="{StaticResource ChromeButtonStyle}" MinHeight="32" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.MoveSelectedQueueItemDownCommand}" Content="DOWN" Style="{StaticResource ChromeButtonStyle}" MinHeight="32" />
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.RemoveSelectedQueueItemCommand}" Content="REMOVE" Style="{StaticResource DangerButtonStyle}" MinHeight="32" />
                            <Button Grid.Column="3" Command="{x:Bind ViewModel.ClearPendingQueueCommand}" Content="CLEAR PENDING" Style="{StaticResource DangerButtonStyle}" MinHeight="32" />
                        </Grid>

                        <TextBlock Grid.Row="3" Text="MATCHING SONGS" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="Bold" Visibility="{x:Bind ViewModel.RecommendationsVisibility, Mode=OneWay}" />

                        <ListView
                            Grid.Row="4"
                            ItemsSource="{x:Bind ViewModel.Recommendations}"
                            MaxHeight="104"
                            Visibility="{x:Bind ViewModel.RecommendationsVisibility, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SongRecommendation">
                                    <Grid Padding="8,4" ColumnSpacing="8" BorderBrush="{StaticResource ListDividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Rank}" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="0">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind MixDisplay}" Foreground="{StaticResource YellowBrush}" FontSize="10" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind MatchDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ListView
                            x:Name="SongQueueList"
                            Grid.Row="5"
                            ItemsSource="{x:Bind ViewModel.QueueViewDeckQueue, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedQueueViewDeckQueueItem, Mode=TwoWay}"
                            SelectionMode="Extended"
                            CanDragItems="True"
                            AllowDrop="True"
                            CanReorderItems="False"
                            DragItemsStarting="QueueList_DragItemsStarting"
                            DragItemsCompleted="List_DragItemsCompleted"
                            DragOver="QueueList_DragOver"
                            Drop="SongQueueList_Drop"
                            DoubleTapped="QueueList_DoubleTapped"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="spotify:DancePilotQueueItem">
                                    <Grid Padding="8,6" ColumnSpacing="8" BorderBrush="{StaticResource ListDividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind QueuePosition}" Foreground="{StaticResource YellowBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="CURRENT SOURCE" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.SpotifyNowPlayingTitle, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.SpotifyNowPlayingArtist, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="OUTPUT" Foreground="{StaticResource BlueBrush}" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedOutputDeviceName, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" TextWrapping="WrapWholeWords" MaxLines="2" />
                        <TextBlock Text="{x:Bind ViewModel.SpotifyTimeRemaining, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.SkipPreviousSpotifyCommand}" Content="PREV" Style="{StaticResource ChromeButtonStyle}" MinWidth="58" MinHeight="56" />
                        <Button Command="{x:Bind ViewModel.RewindPlaybackCommand}" Content="-15" Style="{StaticResource ChromeButtonStyle}" MinWidth="48" MinHeight="56" />
                        <Button Command="{x:Bind ViewModel.TogglePlaybackCommand}" Content="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}" Style="{StaticResource ChromeButtonStyle}" FontSize="18" FontWeight="Bold" MinWidth="92" MinHeight="72" />
                        <Button Command="{x:Bind ViewModel.FastForwardPlaybackCommand}" Content="+15" Style="{StaticResource ChromeButtonStyle}" MinWidth="48" MinHeight="56" />
                        <Button Command="{x:Bind ViewModel.SkipNextSpotifyCommand}" Content="NEXT" Style="{StaticResource ChromeButtonStyle}" MinWidth="58" MinHeight="56" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.SpotifyProgressDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveDeckName, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider
                            x:Name="PlaybackPositionSlider"
                            Minimum="0"
                            Maximum="{x:Bind ViewModel.SeekPositionMaximumSeconds, Mode=OneWay}"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.SeekPositionSeconds, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Spacing="5" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="MAIN VOLUME" Foreground="{StaticResource BlueBrush}" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.MainOutputVolumeDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="VolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.MainOutputVolume, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="5" Command="{x:Bind ViewModel.EmergencyStopCommand}" Content="EMERGENCY PAUSE" Style="{StaticResource DangerButtonStyle}" MinHeight="56" VerticalAlignment="Center" />
                </Grid>
            </Border>
    </Grid>
</Page>
