<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DancePilot.UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:DancePilot.Core.Models"
    xmlns:spotify="using:DancePilot.Core.Spotify"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#05080B"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#05080B" />
        <SolidColorBrush x:Key="TopChromeBrush" Color="#0B1117" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1015" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#111922" />
        <SolidColorBrush x:Key="LineBrush" Color="#27313B" />
        <SolidColorBrush x:Key="MutedLineBrush" Color="#19222C" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F8FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B5C0C9" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7E8A95" />
        <SolidColorBrush x:Key="YellowBrush" Color="#F4B400" />
        <SolidColorBrush x:Key="BlueBrush" Color="#1EA7FF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#32E76A" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#B875FF" />
        <SolidColorBrush x:Key="RedBrush" Color="#F25D4D" />

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="35" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="25" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="SmallMutedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#141C25" />
            <Setter Property="BorderBrush" Value="#293642" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource ChromeButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#5A211B" />
            <Setter Property="BorderBrush" Value="#89362D" />
            <Setter Property="Foreground" Value="#FFB2A8" />
        </Style>

        <Style x:Key="ListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="12"
        Background="{StaticResource AppBackgroundBrush}"
        RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="390" />
                <RowDefinition Height="*" />
                <RowDefinition Height="118" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource TopChromeBrush}" BorderBrush="#141D26" BorderThickness="1" CornerRadius="6">
                <Grid Padding="16,0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xEC4F;" Foreground="{StaticResource BlueBrush}" FontSize="20" />
                        <StackPanel Spacing="0">
                            <TextBlock Text="DancePilot" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="DJ assistant dashboard" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SpotifyOperationMessage, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Double-click source rows to queue; double-click queue rows for actions." Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#0D1913" BorderBrush="#183B25" BorderThickness="1" CornerRadius="5" Padding="12,6">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="AUTOPILOT" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" />
                                <ToggleButton
                                    MinWidth="46"
                                    MinHeight="22"
                                    Padding="5,0"
                                    IsChecked="{x:Bind ViewModel.DeckTransitionEnabled, Mode=TwoWay}"
                                    Content="{x:Bind ViewModel.DeckTransitionStatus, Mode=OneWay}"
                                    FontSize="11"
                                    FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="Compatible next-song planning" Foreground="#91EAA7" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveDeckName, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="4" Click="SettingsButton_Click" Style="{StaticResource ChromeButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="SETTINGS" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="DeckADropTarget"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource YellowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    AllowDrop="True"
                    DragOver="DeckDropTarget_DragOver"
                    Drop="DeckADropTarget_Drop">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.CurrentDeckHeader, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DeckAStatus, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="96" Height="96" Background="#111922" BorderBrush="#2F3C48" BorderThickness="1" CornerRadius="6" Padding="2">
                                <Image Source="{x:Bind ViewModel.CurrentDeckAlbumArt, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.DeckATitle, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" TextWrapping="WrapWholeWords" MaxLines="2" />
                                <TextBlock Text="{x:Bind ViewModel.DeckAArtist, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.DeckADetail, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="10" VerticalAlignment="Bottom">
                            <ItemsControl Height="72" ItemsSource="{x:Bind ViewModel.CurrentWaveform, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="3" Height="{Binding Height}" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Fill}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ProgressBar Height="4" Minimum="0" Maximum="{x:Bind ViewModel.SeekPositionMaximumSeconds, Mode=OneWay}" Value="{x:Bind ViewModel.SeekPositionSeconds, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" Background="#2A3037" />
                        </StackPanel>

                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{x:Bind ViewModel.SelectDeckACommand}" Content="SELECT A" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.RandomizePlaylistToDeckACommand}" Content="RANDOMIZE" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.ClearDeckAQueueCommand}" Content="CLEAR QUEUE" Style="{StaticResource DangerButtonStyle}" MinHeight="34" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="DeckBDropTarget"
                    Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BlueBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    AllowDrop="True"
                    DragOver="DeckDropTarget_DragOver"
                    Drop="DeckBDropTarget_Drop">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.NextDeckHeader, Mode=OneWay}" Foreground="{StaticResource BlueBrush}" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.DeckBStatus, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="96" Height="96" Background="#111922" BorderBrush="#2F3C48" BorderThickness="1" CornerRadius="6" Padding="2">
                                <Image Source="{x:Bind ViewModel.NextDeckAlbumArt, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.DeckBTitle, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" TextWrapping="WrapWholeWords" MaxLines="2" />
                                <TextBlock Text="{x:Bind ViewModel.DeckBArtist, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.DeckBDetail, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="2" Height="42" ItemsSource="{x:Bind ViewModel.NextWaveform, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="3" Height="{Binding Height}" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Fill}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ListView
                            x:Name="DeckBQueueList"
                            Grid.Row="2"
                            Margin="0,52,0,0"
                            ItemsSource="{x:Bind ViewModel.DeckBQueueItems, Mode=OneWay}"
                            SelectionMode="Extended"
                            CanDragItems="True"
                            AllowDrop="True"
                            CanReorderItems="True"
                            DragItemsStarting="QueueList_DragItemsStarting"
                            DragOver="QueueList_DragOver"
                            Drop="DeckBQueueList_Drop"
                            DoubleTapped="QueueList_DoubleTapped"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="spotify:DancePilotQueueItem">
                                    <Grid Padding="8,5" ColumnSpacing="8" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind QueuePosition}" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{x:Bind ViewModel.SelectDeckBCommand}" Content="SELECT B" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.RandomizePlaylistToDeckBCommand}" Content="RANDOMIZE" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.ClearDeckBQueueCommand}" Content="CLEAR QUEUE" Style="{StaticResource DangerButtonStyle}" MinHeight="34" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#130D1D" BorderBrush="#5C2782" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="TRANSITION" Foreground="{StaticResource PurpleBrush}" Style="{StaticResource SectionTitleStyle}" />
                            <ToggleButton
                                HorizontalAlignment="Right"
                                MinWidth="48"
                                MinHeight="24"
                                Padding="8,0"
                                IsChecked="{x:Bind ViewModel.DeckTransitionEnabled, Mode=TwoWay}"
                                Content="{x:Bind ViewModel.DeckTransitionStatus, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="Bold" />
                        </Grid>
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.TransitionModeOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedTransitionMode, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            MinHeight="38" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="1" Maximum="45" Value="{x:Bind ViewModel.TransitionSecondsBeforeEnd, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TransitionSecondsDisplay, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton
                                IsChecked="{x:Bind ViewModel.StartTransitionOnFade, Mode=TwoWay}"
                                Content="{x:Bind ViewModel.StartTransitionOnFadeStatus, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="Bold"
                                MinHeight="30" />
                            <ToggleButton
                                Grid.Column="1"
                                IsChecked="{x:Bind ViewModel.AlwaysFadeSongs, Mode=TwoWay}"
                                Content="{x:Bind ViewModel.AlwaysFadeSongsStatus, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="Bold"
                                MinHeight="30" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="1" Maximum="30" Value="{x:Bind ViewModel.FadeOutSeconds, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.FadeOutSecondsDisplay, Mode=OneWay}" Foreground="{StaticResource RedBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <Slider Grid.Column="2" Minimum="1" Maximum="20" Value="{x:Bind ViewModel.FadeInSeconds, Mode=TwoWay}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.FadeInSecondsDisplay, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.SpotifyTransitionNotice, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{x:Bind ViewModel.TransitionBehaviorNotice, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="WrapWholeWords" />
                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Text="DECK MIXER" Foreground="{StaticResource YellowBrush}" FontSize="12" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.MixerStateDisplay, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="LOW" Foreground="{StaticResource RedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1" Value="{x:Bind ViewModel.LowFrequencyGain, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.LowFrequencyGainDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MID" Foreground="{StaticResource GreenBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1" Value="{x:Bind ViewModel.MidFrequencyGain, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.MidFrequencyGainDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HIGH" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="1" Value="{x:Bind ViewModel.HighFrequencyGain, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.HighFrequencyGainDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="CROSSFADER" Foreground="{StaticResource PurpleBrush}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{x:Bind ViewModel.CrossfaderDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="A" Foreground="{StaticResource YellowBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1" Value="{x:Bind ViewModel.CrossfaderPosition, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="B" Foreground="{StaticResource BlueBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="FREQUENCY ANALYZER" Foreground="{StaticResource BlueBrush}" FontSize="12" FontWeight="Bold" />
                            <ItemsControl Height="66" ItemsSource="{x:Bind ViewModel.FrequencyAnalyzer, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="32" Spacing="2" HorizontalAlignment="Center">
                                            <Grid Height="38" VerticalAlignment="Bottom">
                                                <Rectangle Width="16" Height="{Binding Level}" Fill="{Binding Fill}" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Range}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GreenBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="SOURCE SETUP &amp; MIXES" Foreground="{StaticResource GreenBrush}" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="Prepare metadata and playback handoff sources." Style="{StaticResource SmallMutedStyle}" />
                            <ComboBox
                                ItemsSource="{x:Bind ViewModel.SourceOptions}"
                                SelectedItem="{x:Bind ViewModel.ActiveSource, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                MinHeight="34"
                                Margin="0,6,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="9">
                                <Border Background="#0D1913" BorderBrush="#1B5C35" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="SPOTIFY" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="{x:Bind ViewModel.SpotifyConnectionStatus, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Command="{x:Bind ViewModel.LoadSpotifyPlaylistsCommand}" Content="LOAD PLAYLISTS" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                            <Button Grid.Column="1" Click="SettingsButton_Click" Content="SETUP" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#101821" BorderBrush="#26313C" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="{x:Bind ViewModel.YouTubeSourceVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="YOUTUBE" Foreground="{StaticResource RedBrush}" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="Setup placeholder" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBox PlaceholderText="YouTube playlist URL or channel link" MinHeight="34" />
                                        <Button Content="PREPARE YOUTUBE CONNECTOR" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#101821" BorderBrush="#26313C" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="{x:Bind ViewModel.TidalSourceVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="TIDAL" Foreground="{StaticResource BlueBrush}" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="Setup placeholder" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBox PlaceholderText="Tidal client ID / future connector setting" MinHeight="34" />
                                        <Button Content="PREPARE TIDAL CONNECTOR" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#101821" BorderBrush="#26313C" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="{x:Bind ViewModel.LocalSourceVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="LOCAL SONG MIXES" Foreground="{StaticResource YellowBrush}" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="{x:Bind ViewModel.LocalMusicTracks.Count, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.LocalLibraryStatus, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" TextWrapping="WrapWholeWords" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Command="{x:Bind ViewModel.LoadLocalMusicCommand}" Content="SCAN LOCAL" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                            <Button Grid.Column="1" Command="{x:Bind ViewModel.PlaySelectedLocalMusicCommand}" Content="CUE FILE" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind ViewModel.SpotifySourceColumnWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Bind ViewModel.RequestsColumnWidth, Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="#1D3B52" BorderThickness="1" CornerRadius="6" Padding="14" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="SPOTIFY PLAYLISTS" Foreground="{StaticResource BlueBrush}" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{x:Bind ViewModel.LoadSpotifyPlaylistsCommand}" Content="LOAD" Style="{StaticResource ChromeButtonStyle}" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.PreviewSpotifyPlaylistCommand}" Content="PREVIEW" Style="{StaticResource ChromeButtonStyle}" />
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.ImportSpotifyPlaylistCommand}" Content="IMPORT" Style="{StaticResource ChromeButtonStyle}" />
                        </Grid>
                        <ListView
                            x:Name="SpotifyPlaylistsList"
                            Grid.Row="2"
                            ItemsSource="{x:Bind ViewModel.SpotifyPlaylists, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedSpotifyPlaylist, Mode=TwoWay}"
                            SelectionMode="Extended"
                            CanDragItems="True"
                            DragItemsStarting="SourceList_DragItemsStarting"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="spotify:SpotifyPlaylistSummary">
                                    <Grid Padding="8,6" ColumnSpacing="8" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind OwnerName}" Style="{StaticResource SmallMutedStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind TrackCount}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Bind ViewModel.SpotifySearchRowHeight, Mode=OneWay}" />
                        <RowDefinition Height="{x:Bind ViewModel.SpotifyResultsRowHeight, Mode=OneWay}" />
                        <RowDefinition Height="{x:Bind ViewModel.LocalSearchRowHeight, Mode=OneWay}" />
                        <RowDefinition Height="{x:Bind ViewModel.LocalResultsRowHeight, Mode=OneWay}" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Text="{x:Bind ViewModel.SpotifySearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search Spotify by song, artist, or album"
                            MinHeight="40"
                            FontSize="15" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.SearchSpotifyTracksCommand}" Content="SEARCH" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.PlaySelectedSpotifySearchTrackCommand}" Content="CUE" Style="{StaticResource ChromeButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="10" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#1D3B52" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="PLAYLIST TRACKS" Foreground="{StaticResource BlueBrush}" FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                                <ListView
                                    x:Name="SpotifyPreviewTracksList"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.SpotifyPreviewTracks, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSpotifyTrack, Mode=TwoWay}"
                                    SelectionMode="Extended"
                                    CanDragItems="True"
                                    DragItemsStarting="SourceList_DragItemsStarting"
                                    DoubleTapped="SpotifyPreviewTracksList_DoubleTapped"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ListItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="spotify:SpotifyTrackMetadata">
                                            <Grid Padding="10,6" ColumnSpacing="10" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind DurationDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#1D3B52" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="SEARCH RESULTS" Foreground="{StaticResource BlueBrush}" FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                                <ListView
                                    x:Name="SpotifySearchResultsList"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.SpotifySearchResults, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSpotifySearchTrack, Mode=TwoWay}"
                                    SelectionMode="Extended"
                                    CanDragItems="True"
                                    DragItemsStarting="SourceList_DragItemsStarting"
                                    DoubleTapped="SpotifySearchResultsList_DoubleTapped"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ListItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="spotify:SpotifyTrackMetadata">
                                            <Grid Padding="10,6" ColumnSpacing="10" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind PopularityDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="8" Visibility="{x:Bind ViewModel.LocalSourceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Text="{x:Bind ViewModel.LocalMusicSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Filter local song mixes"
                            MinHeight="40"
                            FontSize="15" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadLocalMusicCommand}" Content="LOCAL" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.SearchLocalMusicCommand}" Content="FILTER" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Grid.Column="3" Command="{x:Bind ViewModel.PlaySelectedLocalMusicCommand}" Content="CUE" Style="{StaticResource ChromeButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="#1B5C35" BorderThickness="1" CornerRadius="6" Visibility="{x:Bind ViewModel.LocalSourceVisibility, Mode=OneWay}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="LOCAL MUSIC FILES" Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                            <ListView
                                x:Name="LocalMusicList"
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.LocalMusicTracks, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedLocalMusicTrack, Mode=TwoWay}"
                                SelectionMode="Extended"
                                CanDragItems="True"
                                DragItemsStarting="SourceList_DragItemsStarting"
                                DoubleTapped="LocalMusicList_DoubleTapped"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource ListItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:LocalMusicTrack">
                                        <Grid Padding="10,6" ColumnSpacing="10" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Folder}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayArtist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Extension}" Foreground="{StaticResource GreenBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.LocalLibraryStatus, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#31404E" BorderThickness="1" CornerRadius="6" Padding="12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="104" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="SONG QUEUE" Foreground="{StaticResource PrimaryTextBrush}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveDeckName, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Click="AddSelectedSourceToDeckA_Click" Content="ADD A" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                            <Button Grid.Column="1" Click="AddSelectedSourceToDeckB_Click" Content="ADD B" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                        </Grid>

                        <TextBlock Grid.Row="2" Text="MATCHING SONGS" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="Bold" />

                        <ListView
                            Grid.Row="3"
                            ItemsSource="{x:Bind ViewModel.Recommendations}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SongRecommendation">
                                    <Grid Padding="8,4" ColumnSpacing="8" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Rank}" Foreground="{StaticResource GreenBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="0">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind MixDisplay}" Foreground="{StaticResource YellowBrush}" FontSize="10" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind MatchDisplay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ListView
                            x:Name="SongQueueList"
                            Grid.Row="4"
                            ItemsSource="{x:Bind ViewModel.ActiveDeckQueue, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedActiveDeckQueueItem, Mode=TwoWay}"
                            SelectionMode="Extended"
                            CanDragItems="True"
                            AllowDrop="True"
                            CanReorderItems="True"
                            DragItemsStarting="QueueList_DragItemsStarting"
                            DragOver="QueueList_DragOver"
                            Drop="SongQueueList_Drop"
                            DoubleTapped="QueueList_DoubleTapped"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="spotify:DancePilotQueueItem">
                                    <Grid Padding="8,6" ColumnSpacing="8" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind QueuePosition}" Foreground="{StaticResource YellowBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="CURRENT SOURCE" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.SpotifyNowPlayingTitle, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.SpotifyNowPlayingArtist, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="OUTPUT" Foreground="{StaticResource BlueBrush}" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedOutputDeviceName, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" TextWrapping="WrapWholeWords" MaxLines="2" />
                        <TextBlock Text="{x:Bind ViewModel.SpotifyTimeRemaining, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.SkipPreviousSpotifyCommand}" Content="PREV" Style="{StaticResource ChromeButtonStyle}" MinWidth="58" MinHeight="56" />
                        <Button Command="{x:Bind ViewModel.RewindPlaybackCommand}" Content="-15" Style="{StaticResource ChromeButtonStyle}" MinWidth="48" MinHeight="56" />
                        <Button Command="{x:Bind ViewModel.TogglePlaybackCommand}" Content="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}" Style="{StaticResource ChromeButtonStyle}" FontSize="18" FontWeight="Bold" MinWidth="92" MinHeight="72" />
                        <Button Command="{x:Bind ViewModel.FastForwardPlaybackCommand}" Content="+15" Style="{StaticResource ChromeButtonStyle}" MinWidth="48" MinHeight="56" />
                        <Button Command="{x:Bind ViewModel.SkipNextSpotifyCommand}" Content="NEXT" Style="{StaticResource ChromeButtonStyle}" MinWidth="58" MinHeight="56" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.SpotifyProgressDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveDeckName, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider
                            x:Name="PlaybackPositionSlider"
                            Minimum="0"
                            Maximum="{x:Bind ViewModel.SeekPositionMaximumSeconds, Mode=OneWay}"
                            StepFrequency="1"
                            Value="{x:Bind ViewModel.SeekPositionSeconds, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Spacing="5" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="VOLUME" Foreground="{StaticResource BlueBrush}" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.DefaultSpotifyVolumeDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="VolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.DefaultSpotifyVolume, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="5" Command="{x:Bind ViewModel.EmergencyStopCommand}" Content="EMERGENCY PAUSE" Style="{StaticResource DangerButtonStyle}" MinHeight="56" VerticalAlignment="Center" />
                </Grid>
            </Border>
    </Grid>
</Page>
