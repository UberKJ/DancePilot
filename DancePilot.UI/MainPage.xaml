<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DancePilot.UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:DancePilot.Core.Models"
    xmlns:spotify="using:DancePilot.Core.Spotify"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#05080B"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#05080B" />
        <SolidColorBrush x:Key="TopChromeBrush" Color="#0B1117" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1015" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#111922" />
        <SolidColorBrush x:Key="LineBrush" Color="#27313B" />
        <SolidColorBrush x:Key="MutedLineBrush" Color="#19222C" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F8FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B5C0C9" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7E8A95" />
        <SolidColorBrush x:Key="YellowBrush" Color="#F4B400" />
        <SolidColorBrush x:Key="BlueBrush" Color="#1EA7FF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#32E76A" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#B875FF" />
        <SolidColorBrush x:Key="RedBrush" Color="#F25D4D" />

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="35" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="25" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="SmallMutedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#141C25" />
            <Setter Property="BorderBrush" Value="#293642" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource ChromeButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="#5A211B" />
            <Setter Property="BorderBrush" Value="#89362D" />
            <Setter Property="Foreground" Value="#FFB2A8" />
        </Style>

        <Style x:Key="ListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="12"
        Background="{StaticResource AppBackgroundBrush}"
        RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="300" />
                <RowDefinition Height="*" />
                <RowDefinition Height="106" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource TopChromeBrush}" BorderBrush="#141D26" BorderThickness="1" CornerRadius="6">
                <Grid Padding="16,0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xEC4F;" Foreground="{StaticResource BlueBrush}" FontSize="20" />
                        <StackPanel Spacing="0">
                            <TextBlock Text="DancePilot" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="DJ assistant dashboard" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SpotifyOperationMessage, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Double-click any song row to queue it on the active deck." Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="#0D1913" BorderBrush="#183B25" BorderThickness="1" CornerRadius="5" Padding="12,6">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="AUTOPILOT" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" />
                                <ToggleButton
                                    MinWidth="46"
                                    MinHeight="22"
                                    Padding="5,0"
                                    IsChecked="{x:Bind ViewModel.DeckTransitionEnabled, Mode=TwoWay}"
                                    Content="{x:Bind ViewModel.DeckTransitionStatus, Mode=OneWay}"
                                    FontSize="11"
                                    FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="Compatible next-song planning" Foreground="#91EAA7" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveDeckName, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="4" Click="SettingsButton_Click" Style="{StaticResource ChromeButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="SETTINGS" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource YellowBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                        <TextBlock Text="{x:Bind ViewModel.CurrentDeckHeader, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SpotifyPlaybackStatus, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="88" Height="88" Source="Assets/AlbumBlueSuede.png" Stretch="UniformToFill" />
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.SpotifyNowPlayingTitle, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" TextWrapping="WrapWholeWords" MaxLines="2" />
                                <TextBlock Text="{x:Bind ViewModel.SpotifyNowPlayingArtist, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.SpotifyProgressDisplay, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="10" VerticalAlignment="Bottom">
                            <ItemsControl Height="72" ItemsSource="{x:Bind ViewModel.CurrentWaveform, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="3" Height="{Binding Height}" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Fill}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ProgressBar Height="4" Minimum="0" Maximum="600" Value="{x:Bind ViewModel.SeekPositionSeconds, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" Background="#2A3037" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BlueBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.NextDeckHeader, Mode=OneWay}" Foreground="{StaticResource BlueBrush}" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.NextUpArtist, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Width="88" Height="88" Source="Assets/AlbumRockinRobin.png" Stretch="UniformToFill" />
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.NextUpTitle, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" TextWrapping="WrapWholeWords" MaxLines="2" />
                                <TextBlock Text="{x:Bind ViewModel.SourceInstruction, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ViewModel.SelectDeckACommand}" Content="DECK A" Style="{StaticResource ChromeButtonStyle}" MinWidth="88" />
                                    <Button Command="{x:Bind ViewModel.SelectDeckBCommand}" Content="DECK B" Style="{StaticResource ChromeButtonStyle}" MinWidth="88" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="2" Height="42" ItemsSource="{x:Bind ViewModel.NextWaveform, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle Width="3" Height="{Binding Height}" Margin="1,0" VerticalAlignment="Center" Fill="{Binding Fill}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ListView
                            x:Name="ActiveDeckQueueList"
                            Grid.Row="2"
                            Margin="0,52,0,0"
                            ItemsSource="{x:Bind ViewModel.ActiveDeckQueue, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedActiveDeckQueueItem, Mode=TwoWay}"
                            DoubleTapped="ActiveDeckQueueList_DoubleTapped"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="spotify:DancePilotQueueItem">
                                    <Grid Padding="8,5" ColumnSpacing="8" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind QueuePosition}" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#130D1D" BorderBrush="#5C2782" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Text="TRANSITION" Foreground="{StaticResource PurpleBrush}" Style="{StaticResource SectionTitleStyle}" />
                            <ToggleButton
                                HorizontalAlignment="Right"
                                MinWidth="48"
                                MinHeight="24"
                                Padding="8,0"
                                IsChecked="{x:Bind ViewModel.DeckTransitionEnabled, Mode=TwoWay}"
                                Content="{x:Bind ViewModel.DeckTransitionStatus, Mode=OneWay}"
                                FontSize="12"
                                FontWeight="Bold" />
                        </Grid>
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.TransitionModeOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedTransitionMode, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            MinHeight="38" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="1" Maximum="45" Value="{x:Bind ViewModel.TransitionSecondsBeforeEnd, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TransitionSecondsDisplay, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.SpotifyTransitionNotice, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GreenBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="SOURCE SETUP &amp; MIXES" Foreground="{StaticResource GreenBrush}" Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Text="Prepare metadata and playback handoff sources." Style="{StaticResource SmallMutedStyle}" />
                            <ComboBox
                                ItemsSource="{x:Bind ViewModel.SourceOptions}"
                                SelectedItem="{x:Bind ViewModel.ActiveSource, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                MinHeight="34"
                                Margin="0,6,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="9">
                                <Border Background="#0D1913" BorderBrush="#1B5C35" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="SPOTIFY" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="{x:Bind ViewModel.SpotifyConnectionStatus, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Command="{x:Bind ViewModel.LoadSpotifyPlaylistsCommand}" Content="LOAD PLAYLISTS" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                            <Button Grid.Column="1" Click="SettingsButton_Click" Content="SETUP" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#101821" BorderBrush="#26313C" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="{x:Bind ViewModel.YouTubeSourceVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="YOUTUBE" Foreground="{StaticResource RedBrush}" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="Setup placeholder" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBox PlaceholderText="YouTube playlist URL or channel link" MinHeight="34" />
                                        <Button Content="PREPARE YOUTUBE CONNECTOR" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#101821" BorderBrush="#26313C" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="{x:Bind ViewModel.TidalSourceVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="TIDAL" Foreground="{StaticResource BlueBrush}" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="Setup placeholder" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBox PlaceholderText="Tidal client ID / future connector setting" MinHeight="34" />
                                        <Button Content="PREPARE TIDAL CONNECTOR" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#101821" BorderBrush="#26313C" BorderThickness="1" CornerRadius="5" Padding="10" Visibility="{x:Bind ViewModel.LocalSourceVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="7">
                                        <Grid>
                                            <TextBlock Text="LOCAL SONG MIXES" Foreground="{StaticResource YellowBrush}" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="{x:Bind ViewModel.LocalMusicTracks.Count, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.LocalLibraryStatus, Mode=OneWay}" Style="{StaticResource SmallMutedStyle}" TextWrapping="WrapWholeWords" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Command="{x:Bind ViewModel.LoadLocalMusicCommand}" Content="SCAN LOCAL" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                            <Button Grid.Column="1" Command="{x:Bind ViewModel.PlaySelectedLocalMusicCommand}" Content="CUE FILE" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Bind ViewModel.SpotifySourceColumnWidth, Mode=OneWay}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{x:Bind ViewModel.RequestsColumnWidth, Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="#1D3B52" BorderThickness="1" CornerRadius="6" Padding="14" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="SPOTIFY PLAYLISTS" Foreground="{StaticResource BlueBrush}" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Command="{x:Bind ViewModel.LoadSpotifyPlaylistsCommand}" Content="LOAD" Style="{StaticResource ChromeButtonStyle}" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.PreviewSpotifyPlaylistCommand}" Content="PREVIEW" Style="{StaticResource ChromeButtonStyle}" />
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.ImportSpotifyPlaylistCommand}" Content="IMPORT" Style="{StaticResource ChromeButtonStyle}" />
                        </Grid>
                        <ListView
                            Grid.Row="2"
                            ItemsSource="{x:Bind ViewModel.SpotifyPlaylists, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedSpotifyPlaylist, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="spotify:SpotifyPlaylistSummary">
                                    <Grid Padding="8,6" ColumnSpacing="8" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{x:Bind Name}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind OwnerName}" Style="{StaticResource SmallMutedStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind TrackCount}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="{x:Bind ViewModel.SpotifySearchRowHeight, Mode=OneWay}" />
                        <RowDefinition Height="{x:Bind ViewModel.SpotifyResultsRowHeight, Mode=OneWay}" />
                        <RowDefinition Height="{x:Bind ViewModel.LocalSearchRowHeight, Mode=OneWay}" />
                        <RowDefinition Height="{x:Bind ViewModel.LocalResultsRowHeight, Mode=OneWay}" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Text="{x:Bind ViewModel.SpotifySearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search Spotify by song, artist, or album"
                            MinHeight="40"
                            FontSize="15" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.SearchSpotifyTracksCommand}" Content="SEARCH" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.PlaySelectedSpotifySearchTrackCommand}" Content="CUE" Style="{StaticResource ChromeButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="10" Visibility="{x:Bind ViewModel.SpotifySourceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#1D3B52" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="PLAYLIST TRACKS" Foreground="{StaticResource BlueBrush}" FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                                <ListView
                                    x:Name="SpotifyPreviewTracksList"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.SpotifyPreviewTracks, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSpotifyTrack, Mode=TwoWay}"
                                    DoubleTapped="SpotifyPreviewTracksList_DoubleTapped"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ListItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="spotify:SpotifyTrackMetadata">
                                            <Grid Padding="10,6" ColumnSpacing="10" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind DurationDisplay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="#1D3B52" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="SEARCH RESULTS" Foreground="{StaticResource BlueBrush}" FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                                <ListView
                                    x:Name="SpotifySearchResultsList"
                                    Grid.Row="1"
                                    ItemsSource="{x:Bind ViewModel.SpotifySearchResults, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSpotifySearchTrack, Mode=TwoWay}"
                                    DoubleTapped="SpotifySearchResultsList_DoubleTapped"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource ListItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="spotify:SpotifyTrackMetadata">
                                            <Grid Padding="10,6" ColumnSpacing="10" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="54" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind PopularityDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="8" Visibility="{x:Bind ViewModel.LocalSourceVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Text="{x:Bind ViewModel.LocalMusicSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Filter local song mixes"
                            MinHeight="40"
                            FontSize="15" />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadLocalMusicCommand}" Content="LOCAL" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.SearchLocalMusicCommand}" Content="FILTER" Style="{StaticResource ChromeButtonStyle}" />
                        <Button Grid.Column="3" Command="{x:Bind ViewModel.PlaySelectedLocalMusicCommand}" Content="CUE" Style="{StaticResource ChromeButtonStyle}" />
                    </Grid>

                    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="#1B5C35" BorderThickness="1" CornerRadius="6" Visibility="{x:Bind ViewModel.LocalSourceVisibility, Mode=OneWay}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="LOCAL MUSIC FILES" Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center" />
                            <ListView
                                x:Name="LocalMusicList"
                                Grid.Row="1"
                                ItemsSource="{x:Bind ViewModel.LocalMusicTracks, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedLocalMusicTrack, Mode=TwoWay}"
                                DoubleTapped="LocalMusicList_DoubleTapped"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource ListItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:LocalMusicTrack">
                                        <Grid Padding="10,6" ColumnSpacing="10" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="58" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Folder}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind DisplayArtist}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Extension}" Foreground="{StaticResource GreenBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.LocalLibraryStatus, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="2" RowSpacing="10" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#31404E" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="REQUESTS" Foreground="{StaticResource PrimaryTextBrush}" Style="{StaticResource SectionTitleStyle}" />
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Requests, Mode=OneWay}" SelectionMode="None" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SongRequest">
                                        <StackPanel Padding="6,5" BorderBrush="#17212A" BorderThickness="0,0,0,1" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Style="{StaticResource SmallMutedStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Grid.Row="2" Content="CLEAR LIST" Style="{StaticResource ChromeButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="#31404E" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="RECOMMENDED NEXT" Foreground="{StaticResource BlueBrush}" Style="{StaticResource SectionTitleStyle}" />
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Recommendations, Mode=OneWay}" SelectionMode="None" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SongRecommendation">
                                        <Grid Padding="6,6" ColumnSpacing="8" BorderBrush="#17212A" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="54" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Rank}" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Artist}" Style="{StaticResource SmallMutedStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind MatchPercent}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="370" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="CURRENT SOURCE" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.SpotifyNowPlayingTitle, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind ViewModel.SpotifyNowPlayingArtist, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="OUTPUT" Foreground="{StaticResource BlueBrush}" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedOutputDeviceName, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" TextWrapping="WrapWholeWords" MaxLines="2" />
                        <TextBlock Text="{x:Bind ViewModel.SpotifyTimeRemaining, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.SkipPreviousSpotifyCommand}" Content="PREV" Style="{StaticResource ChromeButtonStyle}" MinWidth="58" MinHeight="56" />
                        <Button Command="{x:Bind ViewModel.RewindPlaybackCommand}" Content="RR" Style="{StaticResource ChromeButtonStyle}" MinWidth="48" MinHeight="56" />
                        <Button Command="{x:Bind ViewModel.TogglePlaybackCommand}" Content="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}" Style="{StaticResource ChromeButtonStyle}" FontSize="18" FontWeight="Bold" MinWidth="92" MinHeight="72" />
                        <Button Command="{x:Bind ViewModel.FastForwardPlaybackCommand}" Content="FF" Style="{StaticResource ChromeButtonStyle}" MinWidth="48" MinHeight="56" />
                        <Button Command="{x:Bind ViewModel.SkipNextSpotifyCommand}" Content="NEXT" Style="{StaticResource ChromeButtonStyle}" MinWidth="58" MinHeight="56" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="{x:Bind ViewModel.SpotifyProgressDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveDeckName, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="0" Maximum="600" Value="{x:Bind ViewModel.SeekPositionSeconds, Mode=TwoWay}" />
                    </StackPanel>

                    <Button Grid.Column="4" Command="{x:Bind ViewModel.SeekSpotifyCommand}" Content="SEEK" Style="{StaticResource ChromeButtonStyle}" MinHeight="56" VerticalAlignment="Center" />
                    <Button Grid.Column="5" Command="{x:Bind ViewModel.EmergencyStopCommand}" Content="EMERGENCY PAUSE" Style="{StaticResource DangerButtonStyle}" MinHeight="56" VerticalAlignment="Center" />
                </Grid>
            </Border>
    </Grid>
</Page>
