<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DancePilot.UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:DancePilot.Core.Models"
    xmlns:spotify="using:DancePilot.Core.Spotify"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#05080B"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#05080B" />
        <SolidColorBrush x:Key="TopChromeBrush" Color="#0B1117" />
        <SolidColorBrush x:Key="PanelBrush" Color="#0B1015" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#111922" />
        <SolidColorBrush x:Key="LineBrush" Color="#27313B" />
        <SolidColorBrush x:Key="MutedLineBrush" Color="#19222C" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F8FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B5C0C9" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#7E8A95" />
        <SolidColorBrush x:Key="YellowBrush" Color="#F4B400" />
        <SolidColorBrush x:Key="BlueBrush" Color="#1EA7FF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#32E76A" />
        <SolidColorBrush x:Key="PurpleBrush" Color="#B875FF" />
        <SolidColorBrush x:Key="RedBrush" Color="#F25D4D" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#101821" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#26313C" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#070B10" />
        <SolidColorBrush x:Key="ListDividerBrush" Color="#17212A" />
        <SolidColorBrush x:Key="WaveformBackgroundBrush" Color="#070B10" />
        <SolidColorBrush x:Key="ActivePanelBorderBrush" Color="#1D3B52" />
        <SolidColorBrush x:Key="SelectedPanelBorderBrush" Color="#31404E" />

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="35" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="25" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="SmallMutedStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButtonStyle" BasedOn="{StaticResource ChromeButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="ListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="12"
        Background="{StaticResource AppBackgroundBrush}"
        RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="390" />
                <RowDefinition Height="*" />
                <RowDefinition Height="118" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource TopChromeBrush}" BorderBrush="{StaticResource MutedLineBrush}" BorderThickness="1" CornerRadius="6">
                <Grid Padding="16,0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.ColumnSpan="5"
                        Source="Assets/Branding/DancePilotHeader.png"
                        Stretch="UniformToFill"
                        Opacity="0.16"
                        IsHitTestVisible="False" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Border Width="34" Height="34" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                            <Image Source="Assets/Branding/dancepilot_icon_64.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Spacing="0">
                            <TextBlock Text="DancePilot" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="DJ assistant dashboard" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.SpotifyOperationMessage, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="Double-click source rows to queue; double-click queue rows for actions." Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>

                    <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource GreenBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="AUTOPILOT" Foreground="{StaticResource GreenBrush}" FontSize="13" FontWeight="Bold" />
                                <ToggleButton
                                    MinWidth="46"
                                    MinHeight="22"
                                    Padding="5,0"
                                    IsChecked="{x:Bind ViewModel.DeckTransitionEnabled, Mode=TwoWay}"
                                    Content="{x:Bind ViewModel.DeckTransitionStatus, Mode=OneWay}"
                                    FontSize="11"
                                    FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="Compatible next-song planning" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.ClockText, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveDeckName, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="4" Click="SettingsButton_Click" Style="{StaticResource ChromeButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Text="SETTINGS" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="{x:Bind ViewModel.SourceSetupColumnWidth, Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="DeckADropTarget"
                    Background="{x:Bind ViewModel.DeckAPanelBackgroundBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.DeckABorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Opacity="{x:Bind ViewModel.DeckAPanelOpacity, Mode=OneWay}"
                    Padding="16"
                    AllowDrop="True"
                    DragOver="DeckDropTarget_DragOver"
                    Drop="DeckADropTarget_Drop">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.CurrentDeckHeader, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" Style="{StaticResource PanelTitleStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ViewModel.DeckAState.PlayingBadgeText, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckAPlayingBadgeBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckAState.PausedBadgeText, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckAPausedBadgeBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckAState.SelectedBadgeText, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckASelectedBadgeBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckAState.QueueCountText, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckAQueueBadgeBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.DeckAStatus, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckAStatusBrush, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="104" Height="104" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Top">
                                <Image Source="{x:Bind ViewModel.CurrentDeckAlbumArt, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <Grid Grid.Column="1" RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="72" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.DeckATitle, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckATitleBrush, Mode=OneWay}" FontSize="20" FontWeight="Bold" TextWrapping="WrapWholeWords" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckAArtist, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckADetail, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Row="1" Background="{StaticResource WaveformBackgroundBrush}" BorderBrush="{StaticResource MutedLineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Border Height="1" Background="{StaticResource LineBrush}" Opacity="0.72" VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentWaveform, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="2.5" Height="64" Margin="0.05,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="31" />
                                                            <RowDefinition Height="2" />
                                                            <RowDefinition Height="31" />
                                                        </Grid.RowDefinitions>
                                                        <Rectangle Grid.Row="0" Width="1.2" Height="{Binding PeakHeight}" Fill="{Binding PeakFill}" Opacity="0.16" RadiusX="0.6" RadiusY="0.6" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        <Rectangle Grid.Row="0" Width="1.7" Height="{Binding UpperHeight}" Fill="{Binding UpperFill}" RadiusX="0.8" RadiusY="0.8" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource LineBrush}" Opacity="0.65" VerticalAlignment="Center" />
                                                        <Rectangle Grid.Row="2" Width="1.2" Height="{Binding PeakHeight}" Fill="{Binding PeakFill}" Opacity="0.12" RadiusX="0.6" RadiusY="0.6" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                                        <Rectangle Grid.Row="2" Width="1.7" Height="{Binding LowerHeight}" Fill="{Binding LowerFill}" RadiusX="0.8" RadiusY="0.8" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Width="2" Background="{StaticResource PrimaryTextBrush}" Opacity="0.58" HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <ListView
                            x:Name="DeckAQueueList"
                            Grid.Row="2"
                            ItemsSource="{x:Bind ViewModel.DeckAQueueItems, Mode=OneWay}"
                            SelectionMode="Extended"
                            CanDragItems="True"
                            AllowDrop="True"
                            CanReorderItems="False"
                            DragItemsStarting="QueueList_DragItemsStarting"
                            DragItemsCompleted="List_DragItemsCompleted"
                            DragOver="QueueList_DragOver"
                            Drop="DeckAQueueList_Drop"
                            DoubleTapped="QueueList_DoubleTapped"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="spotify:DancePilotQueueItem">
                                    <Grid Padding="8,5" ColumnSpacing="8" BorderBrush="{StaticResource ListDividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind QueuePosition}" Foreground="{StaticResource YellowBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="3" Spacing="5">
                            <CheckBox
                                IsChecked="{x:Bind ViewModel.RemovePlayedQueueItems, Mode=TwoWay}"
                                Content="{x:Bind ViewModel.RemovePlayedQueueItemsStatus, Mode=OneWay}"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                MinHeight="24" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{x:Bind ViewModel.PlayPauseDeckACommand}" Content="{x:Bind ViewModel.DeckAPlayPauseLabel, Mode=OneWay}" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                <TextBlock Grid.Column="1" Text="LEVEL" Foreground="{StaticResource BlueBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <Slider
                                    x:Name="DeckAFaderSlider"
                                    Grid.Column="2"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    Value="{x:Bind ViewModel.DeckAFader, Mode=TwoWay}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.DeckAFaderDisplay, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{x:Bind ViewModel.SelectDeckACommand}" Content="SELECT A" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.RandomizeDeckAQueueCommand}" Content="RANDOMIZE" Style="{StaticResource ChromeButtonStyle}" MinHeight="34" />
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.ClearDeckAQueueCommand}" Content="CLEAR QUEUE" Style="{StaticResource DangerButtonStyle}" MinHeight="34" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    x:Name="DeckBDropTarget"
                    Grid.Column="1"
                    Background="{x:Bind ViewModel.DeckBPanelBackgroundBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.DeckBBorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Opacity="{x:Bind ViewModel.DeckBPanelOpacity, Mode=OneWay}"
                    Padding="16"
                    AllowDrop="True"
                    DragOver="DeckDropTarget_DragOver"
                    Drop="DeckBDropTarget_Drop">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.NextDeckHeader, Mode=OneWay}" Foreground="{StaticResource BlueBrush}" Style="{StaticResource PanelTitleStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ViewModel.DeckBState.PlayingBadgeText, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckBPlayingBadgeBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckBState.PausedBadgeText, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckBPausedBadgeBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckBState.SelectedBadgeText, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckBSelectedBadgeBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckBState.QueueCountText, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckBQueueBadgeBrush, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.DeckBStatus, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckBStatusBrush, Mode=OneWay}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="104" Height="104" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Top">
                                <Image Source="{x:Bind ViewModel.NextDeckAlbumArt, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <Grid Grid.Column="1" RowSpacing="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="72" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.DeckBTitle, Mode=OneWay}" Foreground="{x:Bind ViewModel.DeckBTitleBrush, Mode=OneWay}" FontSize="20" FontWeight="Bold" TextWrapping="WrapWholeWords" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckBArtist, Mode=OneWay}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.DeckBDetail, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Row="1" Background="{StaticResource WaveformBackgroundBrush}" BorderBrush="{StaticResource MutedLineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <Border Height="1" Background="{StaticResource LineBrush}" Opacity="0.72" VerticalAlignment="Center" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.NextWaveform, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="2.5" Height="64" Margin="0.05,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="31" />
                                                            <RowDefinition Height="2" />
                                                            <RowDefinition Height="31" />
                                                        </Grid.RowDefinitions>
                                                        <Rectangle Grid.Row="0" Width="1.2" Height="{Binding PeakHeight}" Fill="{Binding PeakFill}" Opacity="0.16" RadiusX="0.6" RadiusY="0.6" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        <Rectangle Grid.Row="0" Width="1.7" Height="{Binding UpperHeight}" Fill="{Binding UpperFill}" RadiusX="0.8" RadiusY="0.8" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                                        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource LineBrush}" Opacity="0.65" VerticalAlignment="Center" />
                                                        <Rectangle Grid.Row="2" Width="1.2" Height="{Binding PeakHeight}" Fill="{Binding PeakFill}" Opacity="0.12" RadiusX="0.6" RadiusY="0.6" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                                        <Rectangle Grid.Row="2" Width="1.7" Height="{Binding LowerHeight}" Fill="{Binding LowerFill}" RadiusX="0.8" RadiusY="0.8" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Width="2" Background="{StaticResource PrimaryTextBrush}" Opacity="0.58" HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <ListView
                            x:Name="DeckBQueueList"
                            Grid.Row="2"
                            ItemsSource="{x:Bind ViewModel.DeckBQueueItems, Mode=OneWay}"
                            SelectionMode="Extended"
                            CanDragItems="True"
                            AllowDrop="True"
                            CanReorderItems="False"
                            DragItemsStarting="QueueList_DragItemsStarting"
                            DragItemsCompleted="List_DragItemsCompleted"
                            DragOver="QueueList_DragOver"
                            Drop="DeckBQueueList_Drop"
                            DoubleTapped="QueueList_DoubleTapped"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ListItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="spotify:DancePilotQueueItem">
                                    <Grid Padding="8,5" ColumnSpacing="8" BorderBrush="{StaticResource ListDividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind QueuePosition}" Foreground="{StaticResource BlueBrush}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Artist}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind MixDisplay}" Foreground="{StaticResource GreenBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="3" Spacing="5">
                            <CheckBox
                                IsChecked="{x:Bind ViewModel.RemovePlayedQueueItems, Mode=TwoWay}"
